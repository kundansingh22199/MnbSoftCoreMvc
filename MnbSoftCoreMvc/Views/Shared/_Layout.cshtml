                        <a href="https://www.facebook.com/mnbsoftsolution/"><i class="fa-brands fa-facebook-f" target="_blank"></i></a>
                        <a href="https://www.linkedin.com/company/mnb-soft-solution-pvt-ltd/?original_referer=https%3A%2F%2Fmnbsoft.in%2F" target="_blank"><i class="fa-brands fa-linkedin"></i></a>
                        <a href="https://www.instagram.com/mnb.soft.solution.pvt.ltd/" target="_blank"><i class="fa-brands fa-instagram"></i></a>
                        <a href="https://www.youtube.com/@@mnbsoft"><i class="fa-brands fa-youtube" target="_blank"></i></a>
                    </div>
                </div>
                <div class="footer-widget-wrapper style-2">
                    <div class="row justify-content-between">
                        <div class="col-xl-3 col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".3s">
                            <div class="footer-widget-items mt-30">
                                <div class="widget-title mb-25">
