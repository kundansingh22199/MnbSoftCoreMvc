                                </div>
                                <div class="footer-content">
                                    <p class="text-white">G-75, 2nd Floor, Sector 63, Noida, Chotpur, Uttar Pradesh 201301.</p>
                                    <ul class="contact-list-2">
                                        <li>
                                            <a href="tel:+919311221776">+91 9311 221776</a>
                                        </li>
                                        <li>
                                            <a href="mailto=" ask@mnbsoft.com"><span class="__cf_email__">ask@mnbsoft.com</span></a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".7s">
                            <div class="footer-widget-items mt-30">
                                <div class="widget-title mb-25">
                                    <h3 class="font-size-24 text-white font-weight-500">Our Products</h3>
                                </div>
                                <ul class="user-links">

                                    <li><a href="https://taskflier.com" target="_blank">TaskFlier</a></li>
                                    <li><a href="https://mparchi.com" target="_blank">Mparchi</a></li>
                                    <li><a href="https://www.hostguardians.com/" target="_blank">Host Guardians</a></li>
                                    <li><a href="https://mnbpromo.com/" target="_blank">MNB Promo</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".5s">
                            <div class="footer-widget-items mt-30">
                                <div class="widget-title mb-25">
                                    <h3 class="font-size-24 text-white font-weight-500">Quick Link</h3>
                                </div>
                                <div class="user-links-area">
                                    <ul class="user-links">
                                        <li><a href="about-us">About Us</a></li>
                                        <li><a href="our-team">Our Team</a></li>

                                        <li><a href="career">Careers</a></li>
                                        <li><a href="contact-us">Contact Us</a></li>
                                    </ul>
                                    <ul class="user-links">
                                        <li><a href="become-partner">Become a Partner</a></li>
                                        <li><a href="affiliate-partner">Affiliate</a></li>
                                        <li><a href="partner-login">Partner Login</a></li>
                                        <li><a href="affiliate-login">Affiliate Login</a></li>
                                        <li><a href="awards">Awards</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".7s">
                            <div class="footer-widget-items mt-30">
                                <div class="widget-title mb-25">
                                    <h3 class="font-size-24 text-white font-weight-500">Our Solutions</h3>
                                </div>
                                <ul class="user-links">


                                    <li><a href="security">Security</a></li>
                                    <li><a href="terms-of-service">Terms Of Service</a></li>
                                    <li><a href="privacy-policy">Privacy Policy</a></li>
