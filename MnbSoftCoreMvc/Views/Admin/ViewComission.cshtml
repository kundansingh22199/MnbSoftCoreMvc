@model List<BusinessEntity.ModComissionMaster>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "View Comission";
}
<style>
    .blink {
        animation: blink-animation 1s infinite;
    }

    @@keyframes blink-animation {
        0% {
            color: red;
        }

        50% {
            color: blue;
            visibility: hidden;
        }

        100% {
            color: red;
            visibility: visible;
        }
    }
</style>
<div class="page-content">
    <div class="container-xxl">

        <div class="row">
            <div class="col-lg-12">
                <div class="card card-h-100">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h4 class="card-title">View Set Comission</h4>
                            </div>
                            <!--end col-->
                        </div>
                        <!--end row-->
                    </div>
                    <!--end card-header-->
                    <div class="card-body pt-0">
                        <div class="table-responsive browser_users">
                            <table class="table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-top-0">Sr No.</th>
                                        <th class="border-top-0">Product Name</th>
                                        <th class="border-top-0">Rank name</th>
                                        <th class="border-top-0">Commission(%)</th>
                                        <th class="border-top-0">Create Date</th>
                                    </tr>
                                    <!--end tr-->
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        int i = 1;
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@(i++)</td>
                                                <td>@item.productName</td>
                                                <td>@item.rankName</td>
                                                <td class="blink">@item.comissionPer %</td>
                                                <td>@item.createDate.ToString("dd MMM yyyy hh:mm:ss")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center">
                                                <div class="text-center">
                                                    <img src="/assets/images/nodata.png" class="nodataimg" />
                                                    <br />
                                                    <span class="text-nodata mt-2">No Data Found</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                        <!--end /div-->
                    </div>
                    <!--end card-body-->
                </div>
                <!--end card-->
            </div>
            <!--end col-->
            <!--end col-->
        </div>

    </div>
    <!-- container -->
    <!--end footer-->
</div>


