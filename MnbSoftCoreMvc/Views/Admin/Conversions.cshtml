@model List<BusinessEntity.ModSalePurchase>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Sale Purchase Report";
}
<!-- Page Content-->
<div class="page-content">
    <div class="container-xxl">
        <div class="row">
            <div class="col-lg-12">
                <div class="card card-h-100">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h4 class="card-title">@ViewBag.titlename</h4>
                            </div>
                            <!--end col-->
                        </div>
                        <!--end row-->
                    </div>
                    <!--end card-header-->
                    <div class="card-body pt-0">
                        <div class="table-responsive browser_users">
                            <table class="table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-top-0">Sr No.</th>
                                        <th class="border-top-0">Product</th>
                                        <th class="border-top-0">Sale By</th>
                                        <th class="border-top-0">Company</th>
                                        @* <th class="border-top-0">Plan Name</th>
                                        <th class="border-top-0">Configuration</th> *@
                                        <th class="border-top-0">Plan Type</th>
                                        <th class="border-top-0">Sale Amount</th>
                                        <th class="border-top-0 text-end">Commission</th>
                                        <th class="border-top-0 text-end">Status</th>
                                        <th class="border-top-0 text-end">Sale Type</th>
                                        <th class="border-top-0 text-end">Remarks</th>
                                        <th class="border-top-0">Date</th>
                                        <th class="border-top-0 text-end">Action</th>

                                    </tr>
                                    <!--end tr-->
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        int i = 1;
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@(i++)</td>
                                                <td><img src="@item.productImage" alt="" height="24" class="me-2">@item.productName</td>
                                                <td>
                                                    <p class="d-inline-block align-middle mb-0">
                                                        <span class="d-block align-middle mb-0 product-name text-body">@item.partnerCode</span>
                                                        @* <span class="text-muted font-13">@item.company</span> *@
                                                    </p>
                                                </td>
                                                <td>@item.company</td>
                                                @* <td>@item.planName</td>
                                                <td>@item.config</td> *@
                                                <td>
                                                    <span class="badge bg-primary-subtle text-primary">
                                                        @(string.IsNullOrEmpty(item.planType) ? "Yearly" : item.planType)
                                                    </span>
                                                    <br />@item.serverName <br /> @item.planName @item.config
                                                </td>
                                                <td>₹@item.amount</td>
                                                <td class="text-end">₹@item.comission</td>
                                                <td class="text-end">
                                                    <span class="btn btn-sm px-2 align-middle @(item.status == 0 ? "badge bg-warning-subtle text-warning" : item.status == 1 ? "badge bg-primary-subtle text-primary" : "badge bg-danger-subtle text-danger")">
                                                        @(item.status == 0 ? "Pending" : item.status == 1 ? "Approved" : "Rejected")
                                                    </span>
                                                </td>
                                                <td class="">
                                                    <span class="btn btn-sm px-2 align-middle  @(item.saleType == "Paid" ? "badge bg-primary-subtle text-primary" : "badge bg-warning-subtle text-warning")">
                                                        @item.saleType
                                                    </span>
                                                </td>
                                                <td>@item.remarks</td>
                                                <td>@item.createDate.ToString("dd MMM yyyy")</td>
                                                @* <td class="text-end d-flex justify-content-end gap-1">
                                                    <form asp-action="Conversions" method="post">
                                                        <input type="hidden" name="id" value="@item.id" />
                                                        <input type="hidden" name="status" value="1" />
                                                        <button type="submit" class="btn bg-primary text-white btn-sm px-2" onclick="return confirm('Are you sure to Approved this Sale?');" @(item.status == 1 ? "disabled" : "")>Approved</button>
                                                    </form>
                                                    <form asp-action="Conversions" method="post">
                                                        <input type="hidden" name="id" value="@item.id" />
                                                        <input type="hidden" name="status" value="2" />
                                                        <button type="submit" class="btn bg-danger text-white btn-sm px-2" onclick="return confirm('Are you sure to Reject this Sale?');" @(item.status == 1 ? "disabled" : item.status == 2 ? "disabled" : "")>Reject</button>
                                                    </form>
                                                </td> *@
                                                <td class="text-end d-flex justify-content-end gap-1">
                                                    <button type="button"
                                                            class="btn bg-primary text-white btn-sm px-2"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#actionModal"
                                                            data-id="@item.id"
                                                            data-status="1"
                                                            @(item.status == 1 ? "disabled" : "")>
                                                        Approve
                                                    </button>

                                                    <button type="button"
                                                            class="btn bg-danger text-white btn-sm px-2"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#actionModal"
                                                            data-id="@item.id"
                                                            data-status="2"
                                                            @(item.status == 1 ? "disabled" : item.status == 2 ? "disabled" : "")>
                                                        Reject
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="13" class="text-center">
                                                <div class="text-center">
                                                    <img src="/assets/images/nodata.png" class="nodataimg" />
                                                    <br />
                                                    <span class="text-nodata mt-2">No Data Found</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <!--end table-->
                        </div>
                        <!--end /div-->
                    </div>
                    <!--end card-body-->
                </div>
                <!--end card-->
            </div>
            <!--end col-->
            <!--end col-->
        </div>

    </div><!-- container -->
    <!--end footer-->
</div>
<div class="modal fade" id="actionModal" tabindex="-1" aria-labelledby="actionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Conversions" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="actionModalLabel">Confirm Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="modalId" name="id" />
                    <input type="hidden" id="modalStatus" name="status" />
                    <div class="mb-3">
                        <label for="modalRemarks" class="form-label">Remarks</label>
                        <textarea id="modalRemarks" name="remarks" class="form-control" rows="3" placeholder="Enter remarks..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    var actionModal = document.getElementById('actionModal');
    actionModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var id = button.getAttribute('data-id');
        var status = button.getAttribute('data-status');

        document.getElementById('modalId').value = id;
        document.getElementById('modalStatus').value = status;

        // Update modal title dynamically
        document.getElementById('actionModalLabel').textContent =
            status == "1" ? "Approve Sale" : "Reject Sale";
    });
</script>
<script>
    $(document).ready(function () {
        debugger
        @if (TempData["Success"] != null)
        {
                            <text>
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: '@TempData["Success"]'
                            });
                            </text>
        }
        else if (TempData["Err"] != null)
        {
                            <text>
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: '@TempData["Err"]'
                            });
                            </text>
        }
    });
</script>
