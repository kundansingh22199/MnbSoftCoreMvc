@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Change Password";
}
<div class="page-content">
    <div class="container-xxl">

        <div class="row justify-content-center">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h4 class="card-title">Update Password</h4>
                            </div>
                        </div>  
                    </div>
                    <div class="card-body pt-0">
                        <div class="row">
                            <form action="/Admin/changePassword" method="post">
                                <div class="col-lg-6">
                                    <div class="mb-3 row">
                                        <label for="example-text-input" class="col-sm-4 col-form-label text-end">Old Password</label>
                                        <div class="col-sm-8">
                                            <input class="form-control" type="text" name="oldPass" id="example-text-input" required>
                                        </div>
                                    </div>
                                    <div class="mb-3 row">
                                        <label for="example-email-input" class="col-sm-4 col-form-label text-end">New Password</label>
                                        <div class="col-sm-8">
                                            <input class="form-control" type="text" name="newPass" id="example-email-input" required>
                                        </div>
                                    </div>
                                    <div class="mb-3 row">
                                        <label for="example-tel-input" class="col-sm-4 col-form-label text-end">Confirm Password</label>
                                        <div class="col-sm-8">
                                            <input class="form-control" type="text" name="confPass" id="example-tel-input" required>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-sm-8 ms-auto">
                                            <button type="submit" class="btn btn-primary">Submit</button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div> 
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        @if (TempData["Success"] != null)
        {
             if (TempData["Success"].ToString() == "Password Update Successfully")
             {
                  <text>
                  Swal.fire({
                      icon: 'success',
                      title: 'Success',
                      text: '@TempData["Success"]'
                  });
                  </text>
             }
             else
             {
                  <text>
                  Swal.fire({
                      icon: 'error',
                      title: 'Error',
                      text: '@TempData["Success"]'
                  });
                  </text>
             }
        }
    });
</script>
