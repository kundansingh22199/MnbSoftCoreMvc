@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Balance Report";
    var table = ViewBag.BalanceData as System.Data.DataTable;
}

<div class="page-content">
    <div class="container-xxl">
        <div class="row">
            <div class="col-lg-12">
                <div class="card card-h-100">
                    <div class="card-header">
                        <h4 class="card-title">Account Statement Report</h4>
                    </div>

                    <div class="card-body pt-0">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Sr No.</th>
                                        <th>Partner Code</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (table != null && table.Rows.Count > 0)
                                    {
                                        var i = 1;
                                        foreach (System.Data.DataRow row in table.Rows)
                                        {
                                            <tr>
                                                <td>@i</td>
                                                <td>@row["partnerCode"]</td>
                                                <td>@string.Format("{0:N2}", row["amount"])</td>
                                                <td>
                                                    <span class="badge @(row["status"].ToString() == "CR" ? "bg-success" : "bg-danger")">
                                                        @row["status"]
                                                    </span>
                                                </td>
                                                <td>@Convert.ToDateTime(row["createDate"]).ToString("dd-MMM-yyyy HH:mm")</td>
                                            </tr>
                                            i++;
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center">
                                                <img src="/assets/images/nodata.png" class="nodataimg" />
                                                <div class="mt-2 text-muted">No Data Found</div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
