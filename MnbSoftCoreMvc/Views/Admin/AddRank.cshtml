@model List<BusinessEntity.ModRank>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Rank";
}

<div class="page-content">
    <div class="container-xxl">

        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-6 m-auto">
                <div class="card">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h4 class="card-title">Add Rank</h4>
                            </div><!--end col-->
                        </div>  <!--end row-->
                    </div><!--end card-header-->
                    <div class="card-body pt-0">
                        <form method="post" action="/Admin/AddRank">
                            <div class="mb-2">
                                <label class="form-label">Rank Name</label>
                                <input type="text" class="form-control alpha-dot-only" maxlength="20" name="rankName" required>
                            </div>

                            <button type="submit" class="btn btn-primary">Submit</button>
                        </form>

                    </div><!--end card-body-->
                </div><!--end card-->
            </div> <!--end col-->
            <div class="col-md-6 col-lg-6 m-auto">
                <div class="card card-h-100">
                    <div class="card-body pt-0">
                        <div class="table-responsive browser_users">
                            <table class="table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-top-0">Sr No.</th>
                                        <th class="border-top-0">Rank Name</th>
                                        <th class="border-top-0">Create Date</th>
                                    </tr>
                                    <!--end tr-->
                                </thead>
                                <tbody>
                                    @if(Model!=null && Model.Any())
                                    {
                                        int i = 1;
                                        foreach(var item in Model)
                                        {
                                            <tr>
                                                <td>@(i++)</td>
                                                <td>@item.rankName</td>
                                                <td>@item.createDate.ToString("dd MMM yyyy hh:mm:ss")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center">
                                                <div class="text-center">
                                                    <img src="/assets/images/nodata.png" class="nodataimg" />
                                                    <br />
                                                    <span class="text-nodata mt-2">No Data Found</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <!--end /div-->
                    </div>
                    <!--end card-body-->
                </div>
                <!--end card-->
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        @if (TempData["Success"] != null)
        {
                 <text>
                 Swal.fire({
                     icon: 'success',
                     title: 'Success',
                     text: '@TempData["Success"]'
                 });
                 </text>
        }
        else if (TempData["Err"] != null)
        {
                  <text>
                  Swal.fire({
                      icon: 'error',
                      title: 'Error',
                      text: '@TempData["Err"]'
                  });
                  </text>
        }
    });
</script>