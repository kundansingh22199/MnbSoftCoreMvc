@model List<BusinessEntity.ModSalePurchase>
@{
    Layout = "~/Views/Shared/_AffiliateLayout.cshtml";
    ViewData["Title"] = "Conversions";
}

<!-- Page Content-->
<div class="page-content">
    <div class="container-xxl">
        <div class="row">
            <div class="col-lg-12">
                <div class="card card-h-100">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h4 class="card-title">@ViewBag.titlename</h4>
                            </div>
                            <!--end col-->
                        </div>
                        <!--end row-->
                    </div>
                    <!--end card-header-->
                    <div class="card-body pt-0">
                        <div class="table-responsive browser_users">
                            <table class="table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-top-0">Sr No.</th>
                                        <th class="border-top-0">Product</th>
                                        <th class="border-top-0">Sale By</th>
                                        <th class="border-top-0">Company</th>
                                        @* <th class="border-top-0">Plan Name</th>
                                        <th class="border-top-0">Configuration</th> *@
                                        <th class="border-top-0">Plan Type</th>
                                        <th class="border-top-0">Sale Amount</th>
                                        <th class="border-top-0 text-end">Commission</th>
                                        <th class="border-top-0 text-end">Status</th>
                                        <th class="border-top-0 text-end">Sale Type</th>
                                        <th class="border-top-0 text-end">Admin Remarks</th>
                                        <th class="border-top-0">Date</th>
                                        <th class="border-top-0 text-end">Action</th>

                                    </tr>
                                    <!--end tr-->
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        int i = 1;
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@(i++)</td>
                                                <td><img src="@item.productImage" alt="" height="24" class="me-2">@item.productName</td>
                                                <td>
                                                    <p class="d-inline-block align-middle mb-0">
                                                        <span class="d-block align-middle mb-0 product-name text-body">@item.partnerCode</span>
                                                        @* <span class="text-muted font-13">@item.company</span> *@
                                                    </p>
                                                </td>
                                                <td>@item.company</td>
                                                @* <td>@item.planName</td>
                                                <td>@item.config</td> *@
                                                <td>
                                                    <span class="badge bg-primary-subtle text-primary">
                                                        @(string.IsNullOrEmpty(item.planType) ? "Yearly" : item.planType)
                                                    </span>
                                                    <br />@item.serverName <br /> @item.planName @item.config
                                                </td>
                                                <td>₹@item.amount</td>
                                                <td class="text-end">₹@item.comission</td>
                                                <td class="text-end">
                                                    <span class="btn btn-sm px-2 align-middle @(item.status == 0 ? "badge bg-warning-subtle text-warning" : item.status == 1 ? "badge bg-primary-subtle text-primary" : "badge bg-danger-subtle text-danger")">
                                                        @(item.status == 0 ? "Pending" : item.status == 1 ? "Approved" : "Rejected")
                                                    </span>
                                                </td>
                                                <td class="">
                                                    <span class="btn btn-sm px-2 align-middle  @(item.saleType == "Paid" ? "badge bg-primary-subtle text-primary" : "badge bg-warning-subtle text-warning")">
                                                        @item.saleType
                                                    </span>
                                                </td>
                                                <td>@item.adminRemarks</td>

                                                <td>@item.createDate.ToString("dd MMM yyyy")</td>
                                                <td class="text-end">
                                                    <button type="button" class="btn bg-primary-subtle text-primary btn-sm px-2">
                                                        <i class="fa-solid fa-caret-right"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="13" class="text-center">
                                                <div class="text-center">
                                                    <img src="/assets/images/nodata.png" class="nodataimg" />
                                                    <br />
                                                    <span class="text-nodata mt-2">No Data Found</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <!--end table-->
                        </div>
                        <!--end /div-->
                    </div>
                    <!--end card-body-->
                </div>
                <!--end card-->
            </div>
            <!--end col-->
            <!--end col-->
        </div>

    </div><!-- container -->
    <!--end footer-->
</div>
