@model BusinessEntity.ModBankDetails
@{
    Layout = "~/Views/Shared/_AffiliateLayout.cshtml";
    ViewData["Title"] = "Bank Information";
}

<div class="page-content">
    <div class="container-xxl">

        <div class="row justify-content-center">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h4 class="card-title">Bank details (for payments)<span class="@(Model.status == 0 ? "text-warning" : Model.status == 1 ? "text-success" : "text-danger")">(@(Model.status == 0 ? "Pending" : Model.status == 1 ? "Approved" : "Rejected"))</span></h4>
                                <p>Provide the account that should receive partner payouts. For international transfers include SWIFT/BIC; for India include IFSC. Do not share unnecessary sensitive credentials (e.g., passwords).</p>
                            </div><!--end col-->
                        </div>  <!--end row-->
                    </div><!--end card-header-->
                    <div class="card-body pt-0">
                        <div class="row">
                            <form action="/Affiliate/BankInformation" method="post">
                                <div class="col-lg-6">
                                    <div class="mb-3 row">
                                        <label for="example-text-input" class="col-sm-4 col-form-label text-end">Bank name *</label>
                                        <div class="col-sm-8">
                                            <input class="form-control alpha-dot-comma-only" type="text" name="bankName" value="@Model.bankName" id="example-text-input" required>
                                        </div>
                                    </div>
                                    <div class="mb-3 row">
                                        <label for="example-email-input" class="col-sm-4 col-form-label text-end">Branch / City</label>
                                        <div class="col-sm-8">
                                            <input class="form-control alpha-dot-comma-only" type="text" name="branch" value="@Model.branch" id="example-email-input" required>
                                        </div>
                                    </div>
                                    <div class="mb-3 row">
                                        <label for="example-tel-input" class="col-sm-4 col-form-label text-end">Account holder name *</label>
                                        <div class="col-sm-8">
                                            <input class="form-control alpha-dot-only" type="text" name="accountHolder" value="@Model.accountHolder" id="example-tel-input" required>
                                        </div>
                                    </div>
                                    <div class="mb-3 row">
                                        <label for="example-password-input" class="col-sm-4 col-form-label text-end">Account number *</label>
                                        <div class="col-sm-8">
                                            <input class="form-control numeric-only" type="text" name="accountNo" value="@Model.accountNo" minlength="9" maxlength="18" id="example-password-input" required>
                                        </div>
                                    </div>
                                    <div class="mb-3 row">
                                        <label for="example-number-input" class="col-sm-4 col-form-label text-end">Account type</label>
                                        <div class="col-sm-8">
                                            <select class="form-select" onselect="@Model.accountType" name="accountType" required>
                                                <option value="">Select account type</option>
                                                <option value="Current/Checking">Current/Checking</option>
                                                <option value="Savings">Savings</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="mb-3 row">
                                        <label for="example-datetime-local-input" class="col-sm-4 col-form-label text-end">
                                            IFSC / SWIFT / BIC
                                        </label>
                                        <div class="col-sm-8">
                                            <input class="form-control alfa-numeric-only" type="text" name="ifsc" maxlength="11" value="@Model.ifsc" id="example-datetime-local-input">
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-sm-8 ms-auto">
                                            <button type="submit" class="btn btn-primary">Submit</button>
                                        </div>
                                    </div>

                                </div><!--end col-->
                            </form>
                        </div> <!--end row-->
                    </div><!--end card-body-->
                </div><!--end card-->
            </div> <!--end col-->
        </div>




        <!--end row-->
    </div><!-- container -->
    <!--Start Rightbar-->
    <!--Start Rightbar/offcanvas-->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="Appearance" aria-labelledby="AppearanceLabel">
        <div class="offcanvas-header border-bottom justify-content-between">
            <h5 class="m-0 font-14" id="AppearanceLabel">Appearance</h5>
            <button type="button" class="btn-close text-reset p-0 m-0 align-self-center" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <h6>Account Settings</h6>
            <div class="p-2 text-start mt-3">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="settings-switch1">
                    <label class="form-check-label" for="settings-switch1">Auto updates</label>
                </div><!--end form-switch-->
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="settings-switch2" checked="">
                    <label class="form-check-label" for="settings-switch2">Location Permission</label>
                </div><!--end form-switch-->
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="settings-switch3">
                    <label class="form-check-label" for="settings-switch3">Show offline Contacts</label>
                </div><!--end form-switch-->
            </div><!--end /div-->
            <h6>General Settings</h6>
            <div class="p-2 text-start mt-3">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="settings-switch4">
                    <label class="form-check-label" for="settings-switch4">Show me Online</label>
                </div><!--end form-switch-->
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="settings-switch5" checked="">
                    <label class="form-check-label" for="settings-switch5">Status visible to all</label>
                </div><!--end form-switch-->
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="settings-switch6">
                    <label class="form-check-label" for="settings-switch6">Notifications Popup</label>
                </div><!--end form-switch-->
            </div><!--end /div-->
        </div><!--end offcanvas-body-->
    </div>
    <!--end Rightbar/offcanvas-->
    <!--end Rightbar-->
    <!--Start Footer-->

    <footer class="footer text-center text-sm-start d-print-none">
        <div class="container-xxl">
            <div class="row">
                <div class="col-12">
                    <div class="card mb-0 rounded-bottom-0">
                        <div class="card-body">
                            <p class="text-muted mb-0">
                                ©
                                <script>document.write(new Date().getFullYear())</script>2025
                                MNB Soft Solution

                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!--end footer-->
</div>
<script>
    $(document).ready(function () {
        @if (TempData["Success"] != null)
        {
                    <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: '@TempData["Success"]'
                    });
                    </text>
        }
        else if (TempData["Err"] != null)
        {
                    <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: '@TempData["Err"]'
                    });
                    </text>
        }
    });
</script>