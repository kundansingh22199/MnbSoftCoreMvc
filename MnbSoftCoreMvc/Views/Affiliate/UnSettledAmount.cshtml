@model List<BusinessEntity.ModComission>
@{
    Layout = "~/Views/Shared/_AffiliateLayout.cshtml";
    ViewData["Title"] = "UnSettledAmount";
}

<!-- Page Content-->
<div class="page-content">
    <div class="container-xxl">

        <div class="row">
            <div class="col-lg-12">
                <div class="card card-h-100">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="card-title mb-0">UnSettled Amount Details</h4>
                            <span class="badge bg-primary-subtle text-primary">
                                Wallet Balance : @ViewBag.balance
                            </span>
                            <a href="/Affiliate/PendingSettlement" class="btn btn-primary fw-bold">
                                Pending Settlement
                            </a>
                        </div>
                        <!--end row-->
                    </div>
                    <!--end card-header-->
                    <div class="row g-0 h-100">
                        <div class="col-lg-7 border-end">
                            <form class="p-4 pt-3" action="/Affiliate/UnSettledAmount" method="post">
                                <div class="form-group">
                                    <div class="row">
                                        <div class="col-12 col-md-6 col-lg-6 col-xl-6  mb-2 mb-lg-1">
                                            <label class="form-label mt-2" for="pro-start-date">Partner ID</label>
                                            <input type="text" class="form-control datepicker-input alfa-numeric-only" name="partnerCode" value="@ViewBag.partnerCode" placeholder="Enter partner ID" readonly>
                                            <input type="hidden" id="hdnSelectedIds" name="selectedIds" />
                                        </div><!--end col-->
                                        <div class="col-12 col-md-6 col-lg-6 col-xl-6  mb-2 mb-lg-1">
                                            <label class="form-label mt-2" for="pro-rate">Total Amount (in INR)</label>
                                            <input type="text" class="form-control numeric-dot-only" name="totalAmount" id="txtTotalAmount" maxlength="8" readonly required>
                                        </div><!--end col-->
                                        <div class="col-12 col-md-6 col-lg-6 col-xl-6  mb-2 mb-lg-1">
                                            <label class="form-label mt-2" for="pro-rate">Total Commission (in INR)</label>
                                            <input type="text" class="form-control numeric-dot-only" name="totalCommission" id="txtTotalCommission" maxlength="8" readonly required>
                                        </div>
                                        <div class="col-12 col-md-6 col-lg-6 col-xl-6  mb-2 mb-lg-1">
                                            <label class="form-label mt-2" for="pro-rate">Payable Amount (in INR)</label>
                                            <input type="text" class="form-control numeric-dot-only" name="payableAmount" id="txtTotalPayable" maxlength="8" readonly required>
                                        </div>
                                        <div class="col-12 col-md-6 col-lg-6 col-xl-6  mb-2 mb-lg-1" style="display:none">
                                            <label class="form-label mt-2" for="pro-rate">GST (%)</label>
                                            <input type="text" class="form-control numeric-dot-only" name="gstPer" id="txtGst" maxlength="5">
                                            <input type="hidden" id="hdnGstAmt" name="gstAmount" readonly />
                                        </div>
                                        <div class="col-12 col-md-6 col-lg-6 col-xl-6  mb-2 mb-lg-1">
                                            <label class="form-label mt-2" for="pro-rate">TDS (%)</label>
                                            <input type="text" class="form-control numeric-dot-only" name="tdsPer" id="txtTds" maxlength="5">
                                            <input type="text" id="hdnTdsAmt" class="border-0" name="tdsAmount" readonly />
                                        </div>
                                        <div class="col-12 col-md-6 col-lg-6 col-xl-6  mb-2 mb-lg-1">
                                            <label class="form-label mt-2">Use Wallet Balance (Available: @ViewBag.balance)</label>
                                            <input type="text" class="form-control numeric-dot-only" id="walletUsed" name="walletUsed" value="0" maxlength="10" />
                                            <input type="hidden" id="walletBalance" value="@ViewBag.balance" />
                                        </div>
                                        <div class="col-12 col-md-6 col-lg-6 col-xl-6  mb-2 mb-lg-1">
                                            <label class="form-label mt-2" for="pro-rate">Net Payable Amount (in INR)</label>
                                            <input type="text" class="form-control numeric-dot-only" name="netPayableAmount" id="txtNetPayable" maxlength="8" readonly required>
                                        </div>
                                        <div class="col-12 col-md-6 col-lg-6 col-xl-6 mb-2 mb-lg-1">
                                            <label class="form-label mt-2" for="pro-rate">Bank For Payment</label>
                                            <select id="bankSelect" name="bankId" class="form-control" required>
                                                <option value="">---Select Bank---</option>
                                                @if (ViewBag.adminbank != null)
                                                {
                                                    foreach (var item in ViewBag.adminbank)
                                                    {
                                                        <option value="@item.id" data-holder="@item.accountHolder" data-accountno="@item.accountNo"
                                                                data-bankname="@item.bankName" data-type="@item.accountType" data-branch="@item.branch"
                                                                data-ifsc="@item.ifsc">
                                                            @item.bankName (@item.accountNo)
                                                        </option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="col-12 col-md-6 col-lg-6 col-xl-6  mb-2 mb-lg-1">
                                            <label class="form-label mt-2" for="pro-rate">Transaction/UTR No</label>
                                            <input type="text" class="form-control" name="utrNo" id="txtUtrNo" maxlength="22" />
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-5"></div>
                                <button type="submit" class="btn btn-primary">Submit</button>
                            </form>
                        </div>
                        <div id="bankDetailsSection" class="col-lg-5 align-self-center" style="display:none;">
                            <div class="p-4">
                                <ul class="list-style-1 mt-0">
                                    <li><label class="custom-label-2 mb-0">Account holder name : <span id="accHolder"></span></label></li>
                                    <li><label class="custom-label-2 mb-0">Account number : <span id="accNo"></span></label></li>
                                    <li><label class="custom-label-2 mb-0">Bank name : <span id="bankName"></span></label></li>
                                    <li><label class="custom-label-2 mb-0">Account type : <span id="accType"></span></label></li>
                                    <li><label class="custom-label-2 mb-0">Branch / City : <span id="branch"></span></label></li>
                                    <li><label class="custom-label-2 mb-0">IFSC / SWIFT / BIC : <span id="ifsc"></span></label></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="card-body pt-0">
                        <div class="table-responsive browser_users">
                            <table class="table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th><input type="checkbox" id="chkSelectAll" /></th>
                                        <th class="border-top-0">Sr No.</th>
                                        <th class="border-top-0">Partner Code</th>
                                        <th class="border-top-0">Name</th>
                                        <th class="border-top-0">Total Amount</th>
                                        <th class="border-top-0">Total Commission</th>
                                        <th class="border-top-0">Commission(%)</th>
                                        <th class="border-top-0">Status</th>
                                        <th class="border-top-0">Date</th>
                                        <th class="border-top-0 text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        int i = 1;
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="checkbox" class="chkRow" data-id="@item.id" data-amount="@item.totalAmount" data-commission="@item.comission" />
                                                </td>
                                                <td>@(i++)</td>
                                                <td>@item.partnerCode</td>
                                                <td>@item.fullName<br /> @item.businessEmail</td>
                                                <td>@item.totalAmount</td>
                                                <td>@item.comission</td>
                                                <td>@item.comissionPer %</td>
                                                <td>
                                                    <span class="btn btn-sm px-2 align-middle @(item.status == 0 ? "badge bg-warning-subtle text-warning" : item.status == 1 ? "badge bg-primary-subtle text-primary" : "badge bg-danger-subtle text-danger")">
                                                        @(item.status == 0 ? "UnPaid" : item.status == 1 ? "Paid" : "Rejected")
                                                    </span>
                                                </td>
                                                <td>@item.createDate.ToString("dd MMM yyyy")</td>
                                                <td class="text-end"><button type="button" class="btn bg-primary-subtle text-primary btn-sm px-2"><i class="fa-solid fa-caret-right"></i></button></td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="13" class="text-center">
                                                <div class="text-center">
                                                    <img src="/assets/images/nodata.png" class="nodataimg" />
                                                    <br />
                                                    <span class="text-nodata mt-2">No Data Found</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>


    </div>
</div>
<script>
    $(document).ready(function () {
        $("#bankSelect").on("change", function () {
            var selected = $(this).find(":selected");
            if (selected.val() !== "") {
                $("#accHolder").text(selected.data("holder"));
                $("#accNo").text(selected.data("accountno"));
                $("#bankName").text(selected.data("bankname"));
                $("#accType").text(selected.data("type"));
                $("#branch").text(selected.data("branch"));
                $("#ifsc").text(selected.data("ifsc"));
                $("#bankDetailsSection").show();
            } else {
                $("#bankDetailsSection").hide();
            }
        });
    });
</script>
<script>
    $(document).ready(function () {
        @if (TempData["Success"] != null)
        {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: '@TempData["Success"]'
                });
                </text>
        }
        else if (TempData["Err"] != null)
        {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: '@TempData["Err"]'
                });
                </text>
        }
    });
</script>
<script>
    function calculateTotals() {
        let totalAmount = 0;
        let totalCommission = 0;
        let totalPayable = 0;
        let selectedIds = [];

        $(".chkRow:checked").each(function () {
            totalAmount += parseFloat($(this).data("amount")) || 0;
            totalCommission += parseFloat($(this).data("commission")) || 0;
            selectedIds.push($(this).data("id"));
        });

        totalPayable = totalAmount - totalCommission;

        let gstPer = parseFloat($("#txtGst").val()) || 0;
        let tdsPer = parseFloat($("#txtTds").val()) || 0;

        let gstAmt = (totalPayable * gstPer) / 100;
        let tdsAmt = (totalPayable * tdsPer) / 100;

        let finalPayable = totalPayable + gstAmt - tdsAmt;

        let walletBalance = parseFloat($("#walletBalance").val()) || 0;
        let walletUsed = parseFloat($("#walletUsed").val()) || 0;

        if (isNaN(walletUsed)) walletUsed = 0;

        let allowedWalletUsed = Math.min(walletUsed, walletBalance, finalPayable);

        finalPayable -= allowedWalletUsed;

        $("#txtTotalAmount").val(totalAmount.toFixed(2));
        $("#txtTotalCommission").val(totalCommission.toFixed(2));
        $("#txtTotalPayable").val(totalPayable.toFixed(2));
        $("#txtNetPayable").val(finalPayable.toFixed(2));
        $("#hdnGstAmt").val(gstAmt.toFixed(2));
        $("#hdnTdsAmt").val(tdsAmt.toFixed(2));
        $("#hdnSelectedIds").val(selectedIds.join(","));

    }

    $(document).ready(function () {
        $(document).on("change", ".chkRow", function () {
            calculateTotals();
            $("#chkSelectAll").prop("checked", $(".chkRow").length === $(".chkRow:checked").length);
        });

        $("#chkSelectAll").on("change", function () {
            $(".chkRow").prop("checked", $(this).prop("checked"));
            calculateTotals();
        });

        $("#txtGst, #txtTds, #walletUsed").on("keyup change", function () {
            calculateTotals();
        });

        $("#walletUsed").on("blur", function () {
            let walletBalance = parseFloat($("#walletBalance").val()) || 0;
            let finalPayable = parseFloat($("#txtNetPayable").val()) || 0;
            let walletUsed = parseFloat($(this).val()) || 0;

            if (walletUsed > walletBalance) walletUsed = walletBalance;
            if (walletUsed > finalPayable) walletUsed = finalPayable;
            if (walletUsed < 0) walletUsed = 0;

            $(this).val(walletUsed.toFixed(2));
            calculateTotals();
        });

        $("#txtGst").val("0");
        $("#txtTds").val("2");
        $("#walletUsed").val("0");

        calculateTotals();
    });
</script>


