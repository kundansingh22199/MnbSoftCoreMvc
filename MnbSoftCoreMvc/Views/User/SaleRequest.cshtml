<script>
    function calculatePayable() {
        var amount = parseFloat($("#amount").val()) || 0;
        var commission = parseFloat($("#commissionPer").val()) || 0;
        var gst = parseFloat($("#gst").val()) || 0;
        var tds = parseFloat($("#tds").val()) || 0;

        // Calculate deductions
        var commissionAmt = (amount * commission) / 100;
        var gstAmt = (amount * gst) / 100;
        var tdsAmt = (amount * tds) / 100;

        // Final payable
        var payable = amount - (commissionAmt + gstAmt + tdsAmt);

        // Update fields
        $("#commissionAmount").val(commissionAmt.toFixed(2));
        $("#payableAmount").val(payable.toFixed(2));
    }

    $(document).ready(function () {
        $("#amount, #commissionPer, #gst, #tds").on("input", function () {
            calculatePayable();
        });
    });
</script>
