<script>
    $(document).ready(function () {
        let $usersDiv = $("#usersDiv");

        $("#taskflierSection, #hostGuardianSection").hide();

        $("#productSelect").change(function () {
            var selected = $(this).val();

            if (selected === "Taskflier") {
                $("#taskflierSection").show();
                $("#hostGuardianSection").hide();
                $usersDiv.removeClass("d-none");
            }
            else if (selected === "Host Guardians") {
                $("#hostGuardianSection").show();
                $("#taskflierSection").hide();
                $usersDiv.addClass("d-none");
            }
            else {
                $("#taskflierSection, #hostGuardianSection").hide();
                $usersDiv.addClass("d-none");
            }
        });
    });
</script>
@section Scripts {
    <script>
        $(document).ready(function () {
            $("#serverSelect").change(function () {
                let selected = $(this).val();
                let $planType = $("#planType");
                let $configDiv = $("#configDiv");
                let $usersDiv = $("#usersDiv");

                $planType.empty();

                if (selected === "Linux" || selected === "Windows") {
                    $planType.append(`<option value="1 Month">1 Month</option>
                                      <option value="6 Months">6 Months</option>
                                      <option value="12 Months">12 Months</option>
                                      <option value="24 Months">24 Months</option>
                                      <option value="36 Months">36 Months</option>`);
                    $configDiv.removeClass("d-none");
                    $usersDiv.addClass("d-none");

                } else if (selected === "Tally On Cloud") {

                    $planType.append(`<option value="Quarterly">Quarterly</option>
                                      <option value="Half Yearly">Half Yearly</option>
                                      <option value="Yearly">Yearly</option>`);
                    $configDiv.addClass("d-none");
                    $usersDiv.removeClass("d-none");
                } else {
                    $configDiv.addClass("d-none");
                    $usersDiv.addClass("d-none");
                }
            });
        });
    </script>
}

<script>
    $(document).ready(function () {
        @if (TempData["Success"] != null)
        {
                 <text>
                 Swal.fire({
                     icon: 'success',
                     title: 'Success',
                     text: '@TempData["Success"]'
                 });
                 </text>
        }
        else if (TempData["Err"] != null)
        {
                  <text>
                  Swal.fire({
                      icon: 'error',
                      title: 'Error',
                      text: '@TempData["Err"]'
                  });
                  </text>
        }
    });
</script>