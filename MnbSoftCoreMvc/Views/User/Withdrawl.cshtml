@model BusinessEntity.ModBankDetails
@{
    Layout = "~/Views/Shared/_CommonLayout.cshtml";
    ViewData["Title"] = "Withdrawl Request";
}

<div class="page-content">
    <div class="container-xxl">

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-0">
                        <div class="row g-0 h-100">
                            <div class="col-lg-7 border-end">
                                <h4 class="card-title fs-16 mb-0 pt-3 ps-4">Withdrawal Requests 
                                    @if (Model.status == 1)
                                    {
                                        <span class="badge bg-primary-subtle text-primary">Approved Kyc</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger">Pending Kyc</span>
                                    }
                                </h4>

                                <form class="p-4 pt-3" action="/User/Withdrawl" method="post">

                                    <div class="bg-primary-subtle p-2 border-dashed border-primary rounded mt-0">
                                        <img src="assets/images/extra/party.gif" alt="" class="d-inline-block me-1" height="30">
                                        <span class="text-primary fw-semibold">Available Balance - ₹0.00</span>
                                    </div>
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-12 col-md-6 col-lg-6 col-xl-6  mb-2 mb-lg-1">
                                                <label class="form-label mt-2" for="pro-start-date">Partner ID</label>
                                                <input type="text" class="form-control datepicker-input alfa-numeric-only" name="" value="@Model.partnerCode" placeholder="Enter partner ID" readonly>
                                            </div><!--end col-->
                                            <div class="col-12 col-md-6 col-lg-6 col-xl-6  mb-2 mb-lg-1">
                                                <label class="form-label mt-2" for="pro-end-date">Full Name</label>
                                                <input type="text" class="form-control datepicker-input alpha-dot-comma-only" name="" value="@Model.fullName" placeholder="Enter Full Name" readonly>
                                            </div><!--end col-->
                                            <div class="col-12 col-md-6 col-lg-6 col-xl-6  mb-2 mb-lg-1">
                                                <label class="form-label mt-2" for="pro-rate">Email</label>
                                                <input type="text" class="form-control email-only" id="pro-rate" value="@Model.businessEmail" placeholder="Enter Email" readonly>
                                            </div><!--end col-->

                                            <div class="col-12 col-md-6 col-lg-6 col-xl-6  mb-2 mb-lg-1">
                                                <label class="form-label mt-2" for="pro-rate">Mobile</label>
                                                <input type="text" class="form-control numeric-only" maxlength="10" value="@Model.mobile" id="pro-rate" placeholder="Enter Mobile" readonly>
                                            </div>

                                            <div class="col-12 col-md-12 col-lg-12 col-xl-12  mb-2 mb-lg-1">
                                                <label class="form-label mt-2" for="pro-rate">Withdraw Amount (in INR)</label>
                                                <input type="text" class="form-control numeric-only" id="pro-rate" maxlength="8" placeholder="Enter withdraw amount" required>
                                            </div><!--end col-->
                                            <!--end col-->
                                        </div><!--end row-->
                                    </div><!--end form-group-->
                                    <div class="mt-5"></div>
                                    @if (Model.status == 1)
                                    {
                                        <button type="submit" class="btn btn-primary">Submit Request</button>
                                       @*  <button type="button" class="btn btn-danger">Reset</button> *@
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger">Pending Kyc</span>
                                    }
                                </form>  <!--end form-->
                            </div><!--end col-->
                            <div class="col-lg-5 align-self-center">




                                <div class="p-4">



                                    <ul class="list-style-1 mt-0">
                                        <li><label class="custom-label-2 mb-0">Account holder name :</label>@Model.accountHolder</li>
                                        <li><label class="custom-label-2 mb-0">Account number  :</label>@Model.accountNo</li>
                                        <li><label class="custom-label-2 mb-0">Bank name :</label>@Model.bankName</li>
                                        <li><label class="custom-label-2 mb-0">Account type :</label>@Model.accountType</li>
                                        <li><label class="custom-label-2 mb-0">Branch / City :</label>@Model.branch</li>
                                        <li><label class="custom-label-2 mb-0">IFSC / SWIFT / BIC  :</label>@Model.ifsc</li>


                                    </ul>





                                    <div class="p-3  border-dashed border-theme-color  mt-3 rounded">
                                        <h6 class=" m-0 fs-18 fw-medium">Guidelines</h6>

                                        <ul class="list-unstyled pricing-content text-start pt-2 border-0 mb-0">
                                            <li>Minimum withdrawal: ₹1,000.</li>
                                            <li>Payouts are processed on business days only.</li>
                                            <li class="mb-0">Incorrect details can delay or reverse a transfer.</li>

                                        </ul>
                                    </div>






                                </div>

                            </div><!--end col-->
                        </div><!--end row-->
                    </div>
                </div>
            </div> <!-- end col -->
        </div>



    </div>

</div>


