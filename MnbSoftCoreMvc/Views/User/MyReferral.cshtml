@model List<BusinessEntity.ModPartner>
@{
    Layout = "~/Views/Shared/_CommonLayout.cshtml";
    ViewData["Title"] = "My Referral";
}
<!-- Page Content-->
<div class="page-content">
    <div class="container-xxl">
        <div class="row">
            <div class="col-lg-12">
                <div class="card card-h-100">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h4 class="card-title">My Referral</h4>
                            </div>
                            <!--end col-->
                        </div>
                        <!--end row-->
                    </div>
                    <!--end card-header-->
                    <div class="card-body pt-0">
                        <div class="table-responsive browser_users">
                            <table class="table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-top-0">Sr No.</th>
                                        <th class="border-top-0">Name</th>
                                        <th class="border-top-0">Company Name</th>
                                        <th class="border-top-0">Partner Code</th>
                                        <th class="border-top-0">Sponsor Code</th>
                                        <th class="border-top-0">Email</th>
                                        <th class="border-top-0 text-end">Status</th>
                                        <th class="border-top-0 text-end">Date</th>

                                    </tr>
                                    <!--end tr-->
                                </thead>
                                <tbody>
                                    @if(Model!=null && Model.Any())
                                    {
                                        int i = 1;
                                        if (Model != null)
                                        {
                                            foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td class="text-purple fw-medium">@(i++)</td>
                                                    <td class="text-purple fw-medium">@item.fullName</td>
                                                    <td class="text-purple fw-medium">@item.company</td>
                                                    <td class="text-purple fw-medium">@item.partnerCode</td>
                                                    <td class="text-purple fw-medium">@item.sponsorCode</td>
                                                    <td class="text-purple fw-medium">@item.businessEmail</td>
                                                    <td class=" @(item.status == 0 ? "text-warning" : item.status == 1 ? "text-success" : "text-danger")">@(item.status == 0 ? "Pending" : item.status == 1 ? "Approved" : "Rejected")</td>
                                                    <td class="text-purple fw-medium">@item.createDate.ToString("dd MMM yyyy")</td>
                                                </tr>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="13" class="text-center">
                                                <div class="text-center">
                                                    <img src="/assets/images/nodata.png" class="nodataimg" />
                                                    <br />
                                                    <span class="text-nodata mt-2">No Data Found</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                            <!--end table-->
                        </div>
                        <!--end /div-->
                    </div>
                    <!--end card-body-->
                </div>
                <!--end card-->
            </div>
            <!--end col-->
            <!--end col-->
        </div>

    </div><!-- container -->
    <!--end footer-->
</div>