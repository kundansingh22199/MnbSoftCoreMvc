<section class="team-section-five fix have-after pattern">
    <div class="container pt-0">
        <div class="sec-title text-center mb-50">
            <h6 class="sub-title light wow fadeInUp animated" style="visibility: visible; animation-name: fadeInUp;">
                <span class="triangle triangle1"></span>
                <span class="triangle triangle2"></span>
                Become a MNB Reseller
            </h6>
            <h2 class="title text-white wow fadeInUp" data-wow-delay=".3s">Building Success Together</h2>
            <p class="text-white">Partner with us through our Reseller Program and deliver our <br />comprehensive portfolio of cloud solutions to businesses.</p>
            <div class="info mt-50 wow fadeInUp animated" data-wow-delay=".2s" style="visibility: visible; animation-delay: 0.2s; animation-name: fadeInUp;">
                <a href="partner-form" class="theme-bg text-dark btn-style-one wow fadeInUp animated" data-wow-delay=".5s" style="visibility: visible; animation-delay: 0.5s; animation-name: fadeInUp;">
                    Become a Partner
                    <span class="icon"><i class="flaticon-finance-arrow-right-svgrepo-com1-2"></i></span>
                </a>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-9 m-auto">
                <div class="contact-box-style-3 p-1 partner-form">
                    <img src="~/images/partner-bg.png" />
                </div>


            </div>
        </div>
    </div>
</section>
<section class="mail-adres-section pt-0" id="joblist">
    <div class="container pt-0">

        <div class="row justify-content-center g-lg-4 g-md-3 g-2 align-items-end mb-40">
            <div class="col-lg-7 col-md-7">
                <div class="section-header text-center">
                    <h2 class="theme-clr4  wow fadeInUp animated">Benefits of <span class="fw-300">Joining the MNB  <br> Reseller  Program</span></h2>
                </div>
            </div>
        </div>
        <div class="row g-xl-4 g-3">
            <div class="col-sm-4 col-lg-4 col-xl-4 wow fadeInUp" data-wow-delay=".1s">
                <div class="banifits-content mt-30">
                    <div class="content mt-0 mb-20">
                        <h4 class="title">High Earning Potential</h4>
                        <p class="text mb-0">Work fromEnjoy generous profit margins on every product you sell.</p>

                    </div>
                    <div class="content mt-0 mb-20">
                        <h4 class="title"><a href="/">Marketing Materials</a></h4>
                        <p class="text mb-0">Ready-to-use brochures, presentations, and case studies to support your sales efforts.</p>

                    </div>
                    <div class="content mt-0 mb-20">
                        <h4 class="title"><a href="/">Dedicated Account Manager</a></h4>
                        <p class="text mb-0">Personalized guidance to help you close deals and grow your business.</p>

                    </div>
                </div>
            </div>

            <div class="col-sm-4 col-lg-4 col-xl-4 wow fadeInUp" data-wow-delay=".1s">
                <div class="banifits-content">
                    <img src="~/images/partner.png" />
                </div>
            </div>

            <div class="col-sm-4 col-lg-4 col-xl-4 wow fadeInUp" data-wow-delay=".1s">
                <div class="banifits-content mt-30">
                    <div class="content mt-0 mb-20">
                        <h4 class="title">Ongoing Product Updates</h4>
                        <p class="text mb-0">Stay ahead with the latest product improvements and features.</p>

                    </div>
                    <div class="content mt-0 mb-20">
                        <h4 class="title">Flexibility</h4>
                        <p class="text mb-0">Choose which products you want to resell and customize your offerings to your target market.</p>

                    </div>

                    <div class="content mt-0 mb-20">
                        <h4 class="title">Scalability</h4>
                        <p class="text mb-0">Expand your business as you grow; there’s no limit to your earning potential.</p>

                    </div>
                </div>
            </div>


        </div>
    </div>
</section>

<section class="mail-adres-section section-bg" id="joblist">
    <div class="container">

        <div class="row justify-content-center g-lg-4 g-md-3 g-2 align-items-end mb-40">
            <div class="col-lg-7 col-md-7">
                <div class="section-header text-center">
                    <h2 class="theme-clr4 wow fadeInUp animated">Why <span class="fw-300">Partner with MNB Soft</span></h2>
                </div>
            </div>
        </div>
        <div class="row g-xl-4 g-3">
            <div class="col-sm-4 col-lg-4 col-xl-4 wow fadeInUp" data-wow-delay=".1s">
                <div class="mail-address-items border-0">

                    <h4 class="theme-clr4 border-bottom pb-3 mb-3">Strong Profit Margins</h4>
                    <p class="theme-clr4 mb-20">We offer competitive pricing and attractive reseller discounts that allow you to maximize profitability while delivering world-class technology solutions to your customers.</p>


                </div>
            </div>



            <div class="col-sm-4 col-lg-4 col-xl-4 wow fadeInUp" data-wow-delay=".1s">
                <div class="mail-address-items border-0">

                    <h4 class="theme-clr4 border-bottom pb-3 mb-3">White-Label & Co-Branding Options</h4>
                    <p class="theme-clr4 mb-20">Want to build your own brand identity? Our program offers white-label and co-branding opportunities so you can sell products under your own business name while still leveraging MNB’s powerful technology infrastructure.</p>


                </div>
            </div>
            <div class="col-sm-4 col-lg-4 col-xl-4 wow fadeInUp" data-wow-delay=".1s">
                <div class="mail-address-items border-0">

                    <h4 class="theme-clr4 border-bottom pb-3 mb-3">Global Reach with Local Support</h4>
                    <p class="theme-clr4 mb-20">No matter where your clients are located, our solutions are designed to work globally. At the same time, we provide localized support to ensure smooth implementation and customer satisfaction.</p>


                </div>
            </div>





        </div>
    </div>
</section>

<section class="contact-details fix section-padding section-bg pt-0 pb-100">

    <div class="auto-container">


        <div class="row g-5">
            <div class="col-lg-6 content-column p-0">
                <div class="inner-column">
                    <img src="~/images/contact-us.png" />

                    <div class="cont d-flex justify-content-between align-items-center gap-xxl-5 gap-xl-4 gap-3 wow fadeInUp" data-wow-delay=".4s">
                        <div class="">
                            <h4 class="theme-clr4">Let’s Connect</h4>
                            <span class="fz-14 theme-clr4 d-block">

                                Have a question or an idea? We’re just a message away.
                                Reach out for support, collaborations, or project discussions.
                            </span>

                        </div>

                    </div>
                </div>
            </div>
            <div class="col-lg-6 content-column p-0">
                <div class="inner-column right-column">
                    <div class="sec-title mb-20">
                        <h3 class="title wow splt-txt" data-splitting>Frequently Asked Questions (FAQ)</h3>
                    </div>
                    <div class="faq-content-1 mt-2">
                        <ul class="accordion-box">
                            <!--Block-->
                            <li class="accordion block active-block wow fadeInUp">
                                <div class="acc-btn active partner">
                                    Do I need technical expertise to become a reseller?
                                    <i class="arrow-icon fa-solid fa-angle-right"></i>
                                </div>
                                <div class="acc-content current">
                                    <div class="content">
                                        <div class="text">Not at all. While technical knowledge is helpful, our training and support will equip you with everything you need to sell and support our products.</div>
                                    </div>
                                </div>
                            </li>
                            <!--Block-->
                            <li class="accordion block wow fadeInUp" data-wow-delay=".2s">
                                <div class="acc-btn partner">
                                    Can I resell under my own brand?
                                    <i class="arrow-icon fa-solid fa-angle-right"></i>
                                </div>
                                <div class="acc-content">
                                    <div class="content">
                                        <div class="text">Yes. We offer white-label solutions so you can build your own brand while leveraging our technology.</div>
                                    </div>
                                </div>
                            </li>
                            <!--Block-->
                            <li class="accordion block wow fadeInUp" data-wow-delay=".4s">
                                <div class="acc-btn partner">
                                    Is there any minimum sales requirement?
                                    <i class="arrow-icon fa-solid fa-angle-right"></i>
                                </div>
                                <div class="acc-content">
                                    <div class="content">
                                        <div class="text">We have flexible plans to accommodate both new and established resellers. Minimum requirements vary based on the product category, and our team will guide you accordingly.</div>
                                    </div>
                                </div>
                            </li>
                            <!--Block-->
                            <li class="accordion block wow fadeInUp" data-wow-delay=".6s">
                                <div class="acc-btn partner">
                                    What kind of support do I get as a reseller?
                                    <i class="arrow-icon fa-solid fa-angle-right"></i>
                                </div>
                                <div class="acc-content">
                                    <div class="content">
                                        <div class="text">You’ll receive dedicated <strong>account management, product training, marketing materials, and technical support</strong> to help you succeed.</div>
                                    </div>
                                </div>
                            </li>

                            <li class="accordion block wow fadeInUp" data-wow-delay=".6s">
                                <div class="acc-btn partner">
                                    How soon can I start selling?
                                    <i class="arrow-icon fa-solid fa-angle-right"></i>
                                </div>
                                <div class="acc-content">
                                    <div class="content">
                                        <div class="text">Once your application is approved, you can begin selling immediately with full access to our reseller resources.</div>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>