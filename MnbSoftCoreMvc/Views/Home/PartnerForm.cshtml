<script>
    $(document).ready(function () {

        function validateFieldAjax(fieldName, fieldValue) {
            return $.ajax({
                url: '/Home/ValidateField',
                type: 'POST',
                dataType: 'json',
                data: { fieldName: fieldName, fieldValue: fieldValue }
            });
        }

        $("input, select").on("input change", function () {
            $(this).css("border", "").next(".text-danger").remove();
        });

        function showError(el, msg) {
            $(el).focus().css("border", "2px solid red");
            if (!$(el).next().hasClass("text-danger")) {
                $(el).after(`<small class="text-danger">${msg}</small>`);
            } else {
                $(el).next(".text-danger").text(msg);
            }
        }

        $(".theme-btn.btn-style-one[type='button']").click(async function () {
            var partnerCode = $("input[name='partnerCode']").val().trim();
            var company = $("input[name='company']").val().trim();
            var companyWebsite = $("input[name='companyWebsite']").val().trim();
            var name = $("input[name='fullName']").val().trim();
            var country = $("select[name='cntname']").val();
            var state = $("input[name='state']").val().trim();
            var city = $("input[name='city']").val().trim();
            var address = $("input[name='address']").val().trim();
            var gstNo = $("input[name='gstNo']").val().trim();
            var mobile = $("input[name='mobile']").val().trim();
            var email = $("input[name='businessEmail']").val().trim();
            var teamSize = $("input[name='teamSize']").val().trim();
            var checkDefault = $("#checkDefault").is(":checked");

                if (partnerCode !== "") {
                debugger
                    let res = await validateFieldAjax("partnercode", partnerCode);
                if (res.success) {
                    showError("input[name='partnerCode']", "Invalid PartnerCode");
                    return;
                }
            }

            if (!company) return showError("input[name='company']", "Company name is required");
            let companynameCheck = await validateFieldAjax("companyname", company);
            if (!companynameCheck.success) {
                showError("input[name='company']", companynameCheck.message);
                return;
            }

            if (!companyWebsite) return showError("input[name='companyWebsite']", "Company website is required");

            let websiteCheck = await validateFieldAjax("companywebsite", companyWebsite);
            if (!websiteCheck.success) {
                showError("input[name='companyWebsite']", websiteCheck.message);
                return;
            }

            if (!name) return showError("input[name='fullName']", "Full name is required");
            if (!country) return showError("select[name='cntname']", "Country name is required");
            if (!state) return showError("input[name='state']", "State is required");
            if (!city) return showError("input[name='city']", "City is required");
            if (!address) return showError("input[name='address']", "Address is required");

            if (gstNo !== "") {
                if (gstNo.length !== 15) {
                    showError("input[name='gstNo']", "GST number must be 15 characters");
                    return;
                }

                let gstRes = await validateFieldAjax("gstno", gstNo);
                if (!gstRes.success) {
                    showError("input[name='gstNo']", gstRes.message);
                    return;
                }
            }

            if (!mobile || mobile.length !== 10) return showError("input[name='mobile']", "Enter valid 10-digit mobile number");

            let mobileCheck = await validateFieldAjax("partnermobile", mobile);
            if (!mobileCheck.success) {
                showError("input[name='mobile']", mobileCheck.message);
                return;
            }

            if (!email || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email))
                return showError("input[name='businessEmail']", "Enter valid email");

            let emailCheck = await validateFieldAjax("businessemail", email);
            if (!emailCheck.success) {
                showError("input[name='businessEmail']", emailCheck.message);
                return;
            }

            if (!teamSize) return showError("input[name='teamSize']", "Team size is required");

            if (!checkDefault) {
                $("#checkDefault").focus().closest(".form-check").css("outline", "2px solid red");
                return;
            }

            $.ajax({
                url: '/Home/sendOtp',
                type: 'POST',
                data: { email: email, name: name },
                beforeSend: function () { $("#loading").show(); },
                complete: function () { $("#loading").hide(); },
                success: function (msg) {
                    if (msg === "Ok") {
                        $("#txtOtp").show();
                            $("#divallfield").hide();
                        $("button[type='submit']").show();
                        $("button[type='button']").hide();
                        $("input[name='businessEmail']").prop("readonly", true);
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: 'OTP sent successfully! Valid for 5 minutes.'
                        });
                    } else {
                        showError("input[name='businessEmail']", msg);
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Something went wrong. Please try again.'
                    });
                }
            });
        });
    });
</script>
