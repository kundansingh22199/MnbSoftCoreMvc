<script>
    document.addEventListener("DOMContentLoaded", function () {
    var otp = $("input[name='otp']").val().trim();
    if (!otp || otp.length !== 6) { $("input[name='otp']").focus(); return; }

        const form = document.getElementById("myForm");
        const loader = document.getElementById("loading");

        form.addEventListener("submit", function (e) {
            loader.style.display = "block";

            setTimeout(() => {
                loader.style.display = "none";
            }, 10000);
        });
    });
</script>
<script>
    $(document).ready(function () {

        // Debounce utility
        function debounce(fn, delay) {
            let timer;
            return function () {
                clearTimeout(timer);
                let context = this, args = arguments;
                timer = setTimeout(() => fn.apply(context, args), delay);
            };
        }

        // Reset border and error on input
        $("input, select").on("input change", function () {
            $(this).css("border", "").next(".text-danger").remove();
        });

        // Show error beside input
        function showError(el, msg) {
            $(el).focus().css("border", "2px solid red");
            if (!$(el).next().hasClass("text-danger")) {
                $(el).after(`<small class="text-danger">${msg}</small>`);
            } else {
                $(el).next(".text-danger").text(msg);
            }
        }

        // Ajax for field validation (returns Promise)
        function validateFieldAjax(fieldName, fieldValue) {
            return $.ajax({
                url: '/Home/ValidateField',
                type: 'POST',
                dataType: 'json',
                data: { fieldName: fieldName, fieldValue: fieldValue }
            });
        }

        // Inline validation check (on blur)
        // $("input[name='mobile']").on("blur", debounce(function () {
        //     $(this).next(".error-text").remove();
        //     if ($(this).val().length === 10) {
        //         validateFieldAjax("affiliatemobile", $(this).val()).done(function (res) {
        //             if (res.success)
        //                 $(`<span class='error-text text-success'>Ok</span>`).insertAfter($("input[name='mobile']"));
        //             else
        //                 $(`<span class='error-text text-danger'>${res.message}</span>`).insertAfter($("input[name='mobile']"));
        //         });
        //     } else {
        //         $(this).after("<span class='error-text text-danger'>Enter 10-digit mobile</span>");
        //     }
        // }, 300));

        // $("input[name='email']").on("blur", debounce(function () {
        //     let email = $(this).val();
        //     $(this).next(".error-text").remove();
        //     if (email && /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
        //         validateFieldAjax("affiliateemail", email).done(function (res) {
        //             if (res.success)
        //                 $(`<span class='error-text text-success'>Ok</span>`).insertAfter($("input[name='email']"));
        //             else
        //                 $(`<span class='error-text text-danger'>${res.message}</span>`).insertAfter($("input[name='email']"));
        //         });
        //     } else {
        //         $(this).after("<span class='error-text text-danger'>Invalid email format</span>");
        //     }
        // }, 300));

        // ==============================
        // ✅ Button Click Handler
        // ==============================
        $(".theme-btn.btn-style-one[type='button']").click(async function () {
            debugger;
            var fname = $("input[name='firstName']").val().trim();
            var lname = $("input[name='lastName']").val().trim();
            var email = $("input[name='email']").val().trim();
            var mobile = $("input[name='mobile']").val().trim();
            var country = $("select[name='country']").val();
            var subject = $("select[name='subject']").val();
            var checkDefault = $("#checkDefault").is(":checked");
            var checkDecl = $("input.form-check-input[required]").is(":checked");
            var name = fname + " " + lname;

            if (!fname) return showError("input[name='firstName']", "First name is required");
            if (!lname) return showError("input[name='lastName']", "Last name is required");
            if (!email || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email))
                return showError("input[name='email']", "Enter valid email");

            let emailCheck = await validateFieldAjax("affiliateemail", email);
            if (!emailCheck.success) {
                showError("input[name='email']", emailCheck.message);
                return;
            }

            if (!mobile || mobile.length !== 10)
                return showError("input[name='mobile']", "Enter valid 10-digit mobile number");

            let mobileCheck = await validateFieldAjax("affiliatemobile", mobile);
            if (!mobileCheck.success) {
                showError("input[name='mobile']", mobileCheck.message);
                return;
            }

            if (!country) return showError("select[name='country']", "Country name is required");
            if (!subject) return showError("select[name='subject']", "Subject is required");

            if (!checkDefault) {
                $("#checkDefault").focus().closest(".form-check").css("outline", "2px solid red");
                return;
            }
            if (!checkDecl) {
                $("input.form-check-input[required]").first().focus().closest(".form-check").css("outline", "2px solid red");
                return;
            }

            // ===============================
            // ✅ Send OTP
            // ===============================
            $.ajax({
                url: '/Home/sendOtp',
                type: 'POST',
                data: { email: email, name: name },
                beforeSend: function () { $("#loading").show(); },
                complete: function () { $("#loading").hide(); },
                success: function (msg) {
                    if (msg === "Ok") {
                        $("#txtOtp").show();
                        $("#divallfield").hide();
                        $("button[type='submit']").show();
                        $("button[type='button']").hide();
                        $("input[name='businessEmail']").prop("readonly", true);
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: 'OTP sent successfully! Valid for 5 minutes.'
                        });
                    } else {
                        showError("input[name='businessEmail']", msg);
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Something went wrong. Please try again.'
                    });
                }
