<script>
       $(document).ready(function () {
        $(".theme-btn.btn-style-one[type='button']").click(function () {
            var email = $("input[name='email']").val();
            var name = $("input[name='name']").val();

            if (email === "") {
                Swal.fire({
                    icon: 'warning',
                    title: 'Required',
                    text: 'Please enter your email address.'
                });
                return;
            }

            $.ajax({
                url: '/Home/sendOtp',
                type: 'POST',
                data: { email: email,name:name },
                beforeSend: function () {
                $("#loading").show(); // show loader
            },
            complete: function () {
                $("#loading").hide(); // always hide loader (success or error)
            },
                success: function (msg) {
                    if (msg === "Ok") {
                        $("input[name='otp']").closest(".type-feild").show();
                        $("button[type='submit']").show();
                        $("button[type='button']").hide();
                        $("input[name='email']").prop("readonly", true);
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: 'OTP sent successfully to your email. Valid for 5 minutes.'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: msg
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Something went wrong. Please try again.'
                    });
                }
            });
        });
    });

    $(document).ready(function () {
        debugger
        @if (TempData["Success"] != null)
        {
                        <text>
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: '@TempData["Success"]'
                        });
                        </text>
        }
        else if (TempData["Err"] != null)
        {
                        <text>
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: '@TempData["Err"]'
                        });
                        </text>
        }
    });
</script>