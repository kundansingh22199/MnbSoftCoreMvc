@{
    Layout = null;

}
<!DOCTYPE html>
<html lang="en" dir="ltr" data-startbar="dark" data-bs-theme="light">

<head>

    <meta charset="utf-8" />
    <title>Forgot Password</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta content="Admin & Dashboard" name="description" />
    <meta content="" name="author" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- App favicon -->
    <link rel="shortcut icon" href="/assets/images/favicon.ico">

    <!-- App css -->
    <link href="/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body {
            background: url(/images/login-bg.jpg);
            background-size: cover;
            background-attachment: fixed;
        }

        .preloader {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 1000;
            background: #00403491;
            display: flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(6px);
        }

        .loading-container,
        .loadings {
            height: 100px;
            position: relative;
            width: 100px;
            border-radius: 100%;
        }

        .loading-container {
            margin: 40px auto;
        }

        .loadings {
            border: 2px solid transparent;
            border-color: transparent #d8ff00 transparent;
            animation: rotate-loading 1.5s linear 0s infinite normal;
            transform-origin: 50% 50%;
        }

        .loading-container:hover .loadings,
        .loading-container .loadings {
            transition: all 0.5s ease-in-out;
        }

        #loading-icon {
            position: absolute;
            top: 50%;
            left: 50%;
            max-width: 100px;
            transform: translate(-50%, -50%);
            min-width: 70px;
        }

        @@keyframes rotate-loading {
            0%

        {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }

        }
    </style>
</head>


<!-- Top Bar Start -->
<body>
    <div class="container-xxl">
        <div class="row vh-100 d-flex justify-content-center">
            <div class="col-12 align-self-center">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-4 offset-md-8">
                            
                            <div class="card">
                                <div class="card-body p-0 bg-login auth-header-box rounded-top">
                                    <div class="text-center p-3">
                                        <a href="Index" class="logo logo-admin">
                                            <img src="/assets/images/logo-light.png" height="50" alt="logo" class="auth-logo">
                                        </a>
                                        <h4 class="mt-3 mb-1 fw-semibold text-white fs-18">Let's Get Started MNB</h4>
                                        @* <p class="text-muted fw-medium mb-0">Sign in to continue to Partner Panel.</p> *@
                                    </div>
                                </div>
                                <div class="preloader" style="display: none;" id="loading">
                                    <div class="loading-container">
                                        <div class="loadings"></div>
                                        <div id="loading-icon"><img src="/images/loader.png" alt="" style="width:100%;"></div>
                                    </div>
                                </div>
                                <div class="card-body pt-0">
                                    <form class="my-4" action="forgotPassword" method="post">
                                        <div class="form-group mb-2">
                                            <label class="form-label" for="username">Email</label>
                                            <input type="email" class="form-control" id="username" name="email" placeholder="Enter username">
                                        </div>
                                        <div class="form-group mb-2" id="txtpass" style="display:none">
                                            <input name="pass" class="form-control" type="text" placeholder="Enter New Password">
                                        </div>
                                        <div class="form-group mb-2" id="txtOtp" style="display:none">
                                            <input name="otp" class="form-control numeric-only" maxlength="6" type="text" placeholder="OTP">
                                        </div>
                                        <div class="form-group mb-2">
                                            <a href="partner-login" class="font-13"><i class="dripicons-lock"></i>Go To Login Page</a>
                                        </div><!--end col-->
                                        <div class="form-group mb-0 row">
                                            <div class="col-12">
                                                <div class="d-grid mt-3">
                                                    <button type="button" class="btn btn-primary">Submit <i class="fas fa-sign-in-alt ms-1"></i></button>
                                                    <button type="submit" class="btn btn-primary" style="display:none">Forgot <i class="fas fa-sign-in-alt ms-1"></i></button>
                                                </div>
                                            </div><!--end col-->
                                        </div> <!--end form-group-->
                                    </form><!--end form-->
                                </div><!--end card-body-->
                            </div><!--end card-->
                        </div><!--end col-->
                    </div><!--end row-->
                </div><!--end card-body-->
            </div><!--end col-->
        </div><!--end row-->
    </div><!-- container -->
</body>
</html>

<script>
        $(document).ready(function () {
        $("button[type='button']").click(function () {
            debugger
            var email = $("input[name='email']").val();
            if (email === "") {
                Swal.fire({
                    icon: 'warning',
                    title: 'Required',
                    text: 'Please enter your email address.'
                });
                return;
            }

            // Step 1: Check Email
            $.ajax({
                url: '/Home/CheckEmail',
                type: 'POST',
                data: { email: email },
                success: function (res) {
                    debugger
                    if (res.status === "ok") {
                        // Step 2: Send OTP only if email is valid
                        $.ajax({
                            url: '/Home/sendOtp',
                            type: 'POST',
                            data: { email: email },
                            beforeSend: function () {
                                $("#loading").show();
                            },
                            complete: function () {
                                $("#loading").hide();
                            },
                            success: function (msg) {
                                debugger
                                if (msg === "Ok") {
                                    $("#txtOtp").show();
                                    $("#txtpass").show();
                                    $("button[type='submit']").show();
                                    $("button[type='button']").hide();
                                    $("input[name='email']").prop("readonly", true);
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Success',
                                        text: 'OTP sent successfully to your email. Valid for 5 minutes.'
                                    });
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error',
                                        text: msg
                                    });
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: 'Something went wrong. Please try again.'
                                });
                            }
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: res.message
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Something went wrong while checking email.'
                    });
                }
            });
        });
    });

    $(document).ready(function () {
        @if (TempData["Success"] != null)
        {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: '@TempData["Success"]'
                });
                </text>
        }
        else if (TempData["Err"] != null)
        {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: '@TempData["Err"]'
                });
                </text>
        }
    });
</script>